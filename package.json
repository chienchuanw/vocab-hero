{
  "name": "vocab-hero",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter @vocab-hero/web dev",
    "build:web": "pnpm --filter @vocab-hero/web build",
    "test:web": "pnpm --filter @vocab-hero/web test",
    "lint:web": "pnpm --filter @vocab-hero/web lint",
    "dev:desktop": "pnpm --filter @vocab-hero/desktop dev",
    "build:desktop": "pnpm --filter @vocab-hero/desktop build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "msw",
      "esbuild",
      "@swc/core",
      "sharp",
      "@parcel/watcher",
      "unrs-resolver",
      "tesseract.js",
      "electron"
    ]
  }
}
